# Cloud Build upload filter: mirrors .dockerignore, NOT .gitignore.
#
# data/ is included only so that local IPCC PDFs save the build a download
# (each is checked against its pinned sha256 either way). The embedding cache
# does NOT come from the upload: the Dockerfile wipes data/cache, bakes the
# corpus vectors from the eval-cache-v1 release asset pinned by sha256, and
# fails the build unless every chunk has its vector.
#
# Without this file, gcloud would fall back to .gitignore, which excludes
# data/: the build then downloads the PDFs itself and the image is the same.
.git
.github
.venv
__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
htmlcov
.coverage
venv
build
dist
*.egg-info
.firecrawl
# Secrets: a pattern with no slash matches that name at any depth here
# (gitignore syntax), so one line per shape covers every directory.
.env
.env.*
secrets.toml
*.pem
*.key
*credentials*.json
.mcp_publisher_token
.mcpregistry_*
# Local key/value cache (this machine's cached answers and fits).
data/cache/kv
docs
MASTER-PLAN*.md
INTELLIGENCE_SYSTEM_BLUEPRINT.md
.claude
.agents
.serena
.kiro
.code-review-graph
.code-review-graphignore
.devcontainer
.codex
CLAUDE.md
AGENTS.md
.mcp.json
*.pkl
mcp-publisher*
# local copy of the eval-cache asset: the build fetches its own, by sha256
eval-cache-v*.tar.gz
data/telemetry
# the UI reads the favicon (brand logo); the rest of assets/ is README screenshots
assets/*
!assets/favicon.png
evals
tests
